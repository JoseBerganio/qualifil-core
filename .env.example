# ==================================================
# QUALIFIL - ROOT ENVIRONMENT CONFIGURATION
# ==================================================
# Copy this file to .env for local development.
# Never commit .env or production secrets.

# Application
APP_ENV=development
APP_NAME=QUALIFIL
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
APP_TIME_ZONE=Asia/Manila

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Required when the web client calls the API directly from a different origin
# using the httpOnly cookie transport.
DJANGO_CORS_ALLOW_CREDENTIALS=false
# Required for cookie-authenticated unsafe requests from a cross-origin frontend.
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=qualifil
POSTGRES_USER=qualifil
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qualifil:replace-with-a-local-password@localhost:5432/qualifil

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ACCESS_COOKIE_NAME=qualifil_access
JWT_REFRESH_COOKIE_NAME=qualifil_refresh
# Set to true outside local HTTP development.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=

# Authentication throttling and lockout
AUTH_LOGIN_THROTTLE_RATE=10/min
AUTH_REGISTER_THROTTLE_RATE=5/hour
AUTH_REFRESH_THROTTLE_RATE=60/min
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# AI Service
AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_API_KEY=replace-with-a-local-service-key
AI_SERVICE_TIMEOUT_SECONDS=60

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=replace-with-your-provider-api-key

# Embedding Model
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu

# Reranker Model
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_DEVICE=cpu

# OCR
TESSERACT_CMD=/usr/bin/tesseract
OCR_DEFAULT_LANGUAGE=eng
OCR_ADDITIONAL_LANGUAGES=fil

# Object Storage - S3 Compatible
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET_NAME=qualifil-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# Application File Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png

# Frontend
# Web: leave empty during development to use the Vite proxy (same-origin).
#      Set a full origin (for example https://api.qualifil.example) in production.
VITE_API_BASE_URL=
# Mobile: full origin reachable from the device. On a physical device use your
# computer's LAN IP (for example http://192.168.1.10:8000), not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Testing
# Opt-in local fallback when PostgreSQL is unavailable. Leave empty in CI.
DJANGO_TEST_DATABASE=
DJANGO_TEST_SQLITE_NAME=:memory:

# Logging
LOG_LEVEL=INFO

# The LLM model identifier above follows the model label supplied for this project. Confirm the exact provider model ID before deployment.
# VITE_ and EXPO_PUBLIC_ variables are exposed to client builds. Never put secrets in them.
# Use a strong, randomly generated Django secret key and service credentials outside local development.
# The OCR language configuration must match the language data installed in the Tesseract environment.
# Do not assume CPU inference will provide acceptable performance for embedding and reranking. Benchmark and provision resources accordingly.
