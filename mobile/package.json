{
  "name": "qualifil-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@qualifil/api-client": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.12.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.16.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@qualifil/api-client$": "<rootDir>/../packages/api-client/src/index.ts",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
